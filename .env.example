# ---- AI provider: one line switches every agent (azure | openai | gemini | claude | glm) ----
# Per run: motion run "..." --provider gemini      Check keys: motion providers
PROVIDER=azure
# Per-agent overrides (optional). The critic looks at frames (and runs the build's look step),
# so give it a vision model.
# PLANNER=
# BUILDER=
# CRITIC=
# FIXER=

# ---- Providers (all called through the OpenAI SDK) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EFFORT=low
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_EFFORT=low

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

GLM_API_KEY=
GLM_MODEL=glm-4.6
# GLM_BASE_URL=https://api.z.ai/api/paas/v4/
# GLM_EFFORT=low         # GLM thinking is on or off: none|minimal|low = off, medium|high|xhigh = on
# GLM_VISION=false

AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=
# AZURE_EFFORT=low

# If a provider's content filter keeps blocking a turn, retry it on this one (optional):
# FALLBACK_PROVIDER=claude

# ---- Backend API server (server/index.mjs) ----
# Google OAuth 2.0 "Web application" client (console.cloud.google.com > APIs & Services > Credentials).
# Authorized redirect URI must be exactly: <PUBLIC_API_URL>/api/google/callback
# Unset: Google sign-in falls back to a local dev stub that never contacts Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=            # override only if it can't be derived from PUBLIC_API_URL
PUBLIC_API_URL=http://localhost:8080

# ---- Payments: Dodo Payments (server/billing.mjs) ----
# A paid plan exists only after Dodo's webhook confirms it. Test mode keys start dodo_test_.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...       # Dashboard > Webhooks; endpoint <PUBLIC_API_URL>/api/billing/webhook
# DODO_PAYMENTS_ENVIRONMENT=test_mode       # live_mode when you go live
# One subscription product per plan and interval (Dashboard > Products), ids like pdt_...
# DODO_PRODUCT_CREATOR_MONTHLY=
# DODO_PRODUCT_CREATOR_ANNUAL=
# DODO_PRODUCT_PRO_MONTHLY=
# DODO_PRODUCT_PRO_ANNUAL=
# DODO_PRODUCT_ENTERPRISE_MONTHLY=
# DODO_PRODUCT_ENTERPRISE_ANNUAL=
# FRONTEND_URL=http://localhost:3000        # where checkout and the billing portal return to
# ADMIN_EMAILS=you@example.com              # these accounts make films without paying

# Free stock footage and photos (harness/src/media/stock.js)
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ---- Pipeline used by the API server ----
# plan-build (default): short planning calls, then code assembles and the model writes only
# hand-built scenes. agents: the older planner/builder/critic/fixer tool loops (far more tokens).
# PIPELINE=plan-build
# BUILD_LOOK=true                # one vision pass over the frames before render (skipped without vision)
# BUILD_MAX_TOKENS=150000        # hard token cap per build
# BUILD_PARALLEL=6               # scene writes and repairs running at once

# ---- Loop and budget limits (tuned from test runs; see harness notes) ----
REVIEW_ROUNDS=1
FIXER_MAX_TURNS=25
BUILDER_MAX_TURNS=40
CONTEXT_CHAR_BUDGET=60000
# PLANNER_MAX_TURNS=24
# CRITIC_MAX_TURNS=24
# SKILL_READ_CHARS=7000          # max chars per read_skill call
# BUILDER_SKILL_BUDGET=110000    # total skill chars a builder run may read
# JOB_TIMEOUT_MIN=60

# ---- Rendering and sandbox ----
# BASH_PATH=C:\Program Files\Git\bin\bash.exe   # Windows only; found from git on PATH when unset
# RENDER_QUALITY=looks           # draft | looks | delivery
# ALLOW_NETWORK_MEDIA=true       # false adds --local-only to media-use
# COMMAND_TIMEOUT_SEC=600
# JOB_DISK_MB=4096
# SANDBOX_ENABLED=true           # default true when running as root (Docker)
