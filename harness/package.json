{
  "name": "motion-studio-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent HyperFrames video harness (planner, builder, critic, fixer) on the OpenAI SDK, reading .agents/skills progressively.",
  "bin": {
    "motion": "bin/motion.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
